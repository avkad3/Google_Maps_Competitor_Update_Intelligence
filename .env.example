# Copy to .env (never commit it) or set these in your host's environment settings.
# At least one AI key is recommended; without any, the built-in offline analyser is used.
GEMINI_API_KEY=
GROQ_API_KEY=
XAI_API_KEY=
OPENROUTER_API_KEY=
# Optional: preferred provider order (comma separated): gemini,groq,xai,openrouter,offline
AI_PROVIDER_ORDER=gemini,groq,xai,openrouter,offline
# Where the SQLite database and downloaded media live
GMCI_DATA_DIR=./data
# Run Chrome with a window (needed to solve a CAPTCHA by hand on your own machine)
GMCI_HEADLESS=1
# Persistent Chrome profile so cookies from a manual verification are reused
GMCI_CHROME_PROFILE=./data/chrome-profile
# Optional explicit binaries. Chrome is used when found, otherwise Microsoft Edge.
# GMCI_BROWSER=edge (or chrome) forces one.
GMCI_BROWSER=
CHROME_BINARY=
CHROMEDRIVER_PATH=
EDGE_BINARY=
EDGEDRIVER_PATH=
# After a scrape finds new posts: analyse them, then generate this many ideas / complete updates (0 = off)
GMCI_AUTO_IDEAS=5
GMCI_AUTO_UPDATES=2
# Load the demo dataset automatically when the database is empty
GMCI_SEED_DEMO=1
# Flask secret for flash messages
SECRET_KEY=change-me
